{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tabito-payroll-system",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // BOOTSTRAP_SECRET is intentionally absent here. Configure it as an
  // encrypted Worker secret with: npx wrangler secret put BOOTSTRAP_SECRET
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tabito-payroll-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "tabito-payroll-files"
    }
  ],
  "triggers": {
    "crons": ["5 15 * * *", "20 15 * * *", "35 15 * * *", "50 15 * * *"]
  },
  "observability": { "enabled": true }
}
